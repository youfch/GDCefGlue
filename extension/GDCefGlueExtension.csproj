<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CefGlue.Common.targets expects Pkgcef_redist_osx_arm64 but NuGet generates Pkgcef_redist_osxarm64 -->
    <Pkgcef_redist_osx_arm64>$(Pkgcef_redist_osxarm64)</Pkgcef_redist_osx_arm64>
    <!-- 仅 Windows 启用 GPU 加速（D3D11on12/Vortice）。其他平台编译产物不包含 Vortice，运行时返回 null 走 CPU 回退 -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);GD_GPU_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Godot.Bindings">
      <HintPath>Dll\Godot.Bindings.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="cef.redist.linux64" Version="149.0.4" GeneratePathProperty="true" />
    <PackageReference Include="cef.redist.linuxarm64" Version="149.0.4" GeneratePathProperty="true" />
    <PackageReference Include="cef.redist.osx64" Version="149.0.4" GeneratePathProperty="true" />
    <PackageReference Include="cef.redist.osxarm64" Version="149.0.4" GeneratePathProperty="true" />
    <PackageReference Include="CefGlue.BrowserProcess.runtime" Version="149.7827.156" />
    <PackageReference Include="CefGlue.Common" Version="149.7827.156" />
    <PackageReference Include="CefGlue.Common.ARM64" Version="149.7827.156" />
    <PackageReference Include="chromiumembeddedframework.runtime" Version="149.0.4" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="149.0.4" />
  </ItemGroup>

  <!-- GPU 加速依赖：仅 Windows 平台引用 Vortice，其他平台不解析/不携带这些 DLL -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
  </ItemGroup>

</Project>