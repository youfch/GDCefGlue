<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DotnetVersion>net8.0</DotnetVersion>
    
    <!-- CEF versions are resolved automatically from the PackageReference versions below -->
    <!-- MSBuild exposes $(Pkg<PackageNameWithDots>) properties after restore -->
  </PropertyGroup>

  <!-- Platform-specific CEF runtime packages (change versions here, everything else auto-resolves) -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="CefGlue.Common" Version="149.7827.156" GeneratePathProperty="true" />
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="149.0.4" GeneratePathProperty="true" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="CefGlue.Common" Version="149.7827.156" GeneratePathProperty="true" />
    <PackageReference Include="cef.redist.linux64" Version="149.0.4" GeneratePathProperty="true" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="CefGlue.Common" Version="149.7827.156" GeneratePathProperty="true" />
    <PackageReference Include="cef.redist.osx64" Version="149.0.4" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Windows: Copy CEF files -->
  <Target Name="CopyCefFilesToOutput_Windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" AfterTargets="Build">
    <PropertyGroup>
      <!-- $(Pkg...) auto-resolved by MSBuild after NuGet restore -->
      <CefPackagePath>$(Pkgchromiumembeddedframework_runtime_win-x64)\runtimes\win-x64\native\</CefPackagePath>
      <CefLocalesPath>$(Pkgchromiumembeddedframework_runtime_win-x64)\CEF\win-x64\locales\</CefLocalesPath>
      <BrowserProcessPath>$(PkgCefGlue_Common)\bin\win-x64\</BrowserProcessPath>
      <CefOutputPath>$(TargetDir)runtimes\win-x64\native\</CefOutputPath>
      <CefLocalesOutputPath>$(TargetDir)runtimes\win-x64\native\locales\</CefLocalesOutputPath>
      <BrowserProcessSubDir>$(TargetDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(TargetDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Build Configuration (Windows) ===" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    <Message Text="BrowserProcessPath: $(BrowserProcessPath)" Importance="high" />
    <Message Text="TargetDir: $(TargetDir)" Importance="high" />
    
    <MakeDir Directories="$(CefOutputPath)" />
    <MakeDir Directories="$(CefLocalesOutputPath)" />
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(CefOutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    
    <ItemGroup>
      <CefLocaleFiles Include="$(CefLocalesPath)*.pak" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(CefLocalesOutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(RootLocalesPath)" SkipUnchangedFiles="true" />
    
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    
    <Message Text="=== CEF Copy Complete (Windows) ===" Importance="high" />
  </Target>

  <!-- Linux: Copy CEF files and set permissions -->
  <Target Name="CopyCefFilesToOutput_Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" AfterTargets="Build">
    <PropertyGroup>
      <CefPackagePath>$(Pkgcef_redist_linux64)\CEF\</CefPackagePath>
      <BrowserProcessPath>$(PkgCefGlue_Common)\bin\linux-x64\</BrowserProcessPath>
      <BrowserProcessSubDir>$(TargetDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(TargetDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Build Configuration (Linux) ===" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    <Message Text="BrowserProcessPath: $(BrowserProcessPath)" Importance="high" />
    <Message Text="TargetDir: $(TargetDir)" Importance="high" />
    
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <!-- Copy CEF native files -->
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    
    <!-- Copy BrowserProcess files -->
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" />
    
    <!-- Set executable permissions for Linux -->
    <Exec Command="chmod +x &quot;$(TargetDir)cef.so&quot;" Condition="Exists('$(TargetDir)cef.so')" />
    <Exec Command="chmod +x &quot;$(TargetDir)chrome-sandbox&quot;" Condition="Exists('$(TargetDir)chrome-sandbox')" />
    <Exec Command="chmod +x &quot;$(TargetDir)libcef.so&quot;" Condition="Exists('$(TargetDir)libcef.so')" />
    <Exec Command="chmod +x &quot;$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess&quot;" Condition="Exists('$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess')" />
    <Exec Command="chmod -R +x &quot;$(TargetDir)swiftshader&quot;" Condition="Exists('$(TargetDir)swiftshader')" />
    
    <Message Text="=== CEF Copy Complete (Linux) ===" Importance="high" />
  </Target>

  <!-- macOS: Copy CEF files and set permissions -->
  <Target Name="CopyCefFilesToOutput_macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" AfterTargets="Build">
    <PropertyGroup>
      <CefPackagePath>$(Pkgcef_redist_osx64)\CEF\</CefPackagePath>
      <BrowserProcessPath>$(PkgCefGlue_Common)\bin\osx-x64\</BrowserProcessPath>
      <BrowserProcessSubDir>$(TargetDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(TargetDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Build Configuration (macOS) ===" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    <Message Text="BrowserProcessPath: $(BrowserProcessPath)" Importance="high" />
    <Message Text="TargetDir: $(TargetDir)" Importance="high" />
    
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <!-- Copy CEF native files -->
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    
    <!-- Copy BrowserProcess files -->
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" />
    
    <!-- Set executable permissions for macOS -->
    <Exec Command="chmod +x &quot;$(TargetDir)cef.so&quot;" Condition="Exists('$(TargetDir)cef.so')" />
    <Exec Command="chmod +x &quot;$(TargetDir)libcef.dylib&quot;" Condition="Exists('$(TargetDir)libcef.dylib')" />
    <Exec Command="chmod +x &quot;$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess&quot;" Condition="Exists('$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess')" />
    <Exec Command="chmod +x &quot;$(TargetDir)libEGL.dylib&quot;" Condition="Exists('$(TargetDir)libEGL.dylib')" />
    <Exec Command="chmod +x &quot;$(TargetDir)libGLESv2.dylib&quot;" Condition="Exists('$(TargetDir)libGLESv2.dylib')" />
    <Exec Command="chmod +x &quot;$(TargetDir)libvk_swiftshader.dylib&quot;" Condition="Exists('$(TargetDir)libvk_swiftshader.dylib')" />
    
    <Message Text="=== CEF Copy Complete (macOS) ===" Importance="high" />
  </Target>

  <!-- Windows: Publish CEF files -->
  <Target Name="CopyCefFilesForPublish_Windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" AfterTargets="Publish">
    <PropertyGroup>
      <CefPackagePath>$(Pkgchromiumembeddedframework_runtime_win-x64)\runtimes\win-x64\native\</CefPackagePath>
      <CefLocalesPath>$(Pkgchromiumembeddedframework_runtime_win-x64)\CEF\win-x64\locales\</CefLocalesPath>
      <BrowserProcessPath>$(PkgCefGlue_Common)\bin\win-x64\</BrowserProcessPath>
      <CefOutputPath>$(PublishDir)runtimes\win-x64\native\</CefOutputPath>
      <CefLocalesOutputPath>$(PublishDir)runtimes\win-x64\native\locales\</CefLocalesOutputPath>
      <BrowserProcessSubDir>$(PublishDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(PublishDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Publish Configuration (Windows) ===" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    <Message Text="PublishDir: $(PublishDir)" Importance="high" />
    
    <MakeDir Directories="$(CefOutputPath)" />
    <MakeDir Directories="$(CefLocalesOutputPath)" />
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(CefOutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    
    <ItemGroup>
      <CefLocaleFiles Include="$(CefLocalesPath)*.pak" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(CefLocalesOutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(RootLocalesPath)" SkipUnchangedFiles="true" />
    
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    
    <Message Text="=== CEF Publish Complete (Windows) ===" Importance="high" />
  </Target>

  <!-- Linux: Publish CEF files and set permissions -->
  <Target Name="CopyCefFilesForPublish_Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" AfterTargets="Publish">
    <PropertyGroup>
      <CefPackagePath>$(Pkgcef_redist_linux64)\CEF\</CefPackagePath>
      <BrowserProcessPath>$(PkgCefGlue_Common)\bin\linux-x64\</BrowserProcessPath>
      <BrowserProcessSubDir>$(PublishDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(PublishDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Publish Configuration (Linux) ===" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" />
    
    <!-- Set executable permissions for Linux -->
    <Exec Command="chmod +x &quot;$(PublishDir)cef.so&quot;" Condition="Exists('$(PublishDir)cef.so')" />
    <Exec Command="chmod +x &quot;$(PublishDir)chrome-sandbox&quot;" Condition="Exists('$(PublishDir)chrome-sandbox')" />
    <Exec Command="chmod +x &quot;$(PublishDir)libcef.so&quot;" Condition="Exists('$(PublishDir)libcef.so')" />
    <Exec Command="chmod +x &quot;$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess&quot;" Condition="Exists('$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess')" />
    <Exec Command="chmod -R +x &quot;$(PublishDir)swiftshader&quot;" Condition="Exists('$(PublishDir)swiftshader')" />
    
    <Message Text="=== CEF Publish Complete (Linux) ===" Importance="high" />
  </Target>

  <!-- macOS: Publish CEF files and set permissions -->
  <Target Name="CopyCefFilesForPublish_macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" AfterTargets="Publish">
    <PropertyGroup>
      <CefPackagePath>$(Pkgcef_redist_osx64)\CEF\</CefPackagePath>
      <BrowserProcessPath>$(PkgCefGlue_Common)\bin\osx-x64\</BrowserProcessPath>
      <BrowserProcessSubDir>$(PublishDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(PublishDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Publish Configuration (macOS) ===" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" />
    
    <!-- Set executable permissions for macOS -->
    <Exec Command="chmod +x &quot;$(PublishDir)cef.so&quot;" Condition="Exists('$(PublishDir)cef.so')" />
    <Exec Command="chmod +x &quot;$(PublishDir)libcef.dylib&quot;" Condition="Exists('$(PublishDir)libcef.dylib')" />
    <Exec Command="chmod +x &quot;$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess&quot;" Condition="Exists('$(BrowserProcessSubDir)Xilium.CefGlue.BrowserProcess')" />
    <Exec Command="chmod +x &quot;$(PublishDir)libEGL.dylib&quot;" Condition="Exists('$(PublishDir)libEGL.dylib')" />
    <Exec Command="chmod +x &quot;$(PublishDir)libGLESv2.dylib&quot;" Condition="Exists('$(PublishDir)libGLESv2.dylib')" />
    <Exec Command="chmod +x &quot;$(PublishDir)libvk_swiftshader.dylib&quot;" Condition="Exists('$(PublishDir)libvk_swiftshader.dylib')" />
    
    <Message Text="=== CEF Publish Complete (macOS) ===" Importance="high" />
  </Target>
</Project>
