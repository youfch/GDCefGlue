[configuration]
entry_symbol = "gdcefglue_library_init"
compatibility_minimum = 4.6

[libraries]
windows.x86_64.debug = "res://addons/gdcefglue/windows-x64/GDCefGlueExtension.dll"
windows.x86_64.release = "res://addons/gdcefglue/windows-x64/GDCefGlueExtension.dll"
linux.x86_64.debug = "res://addons/gdcefglue/linux-x64/GDCefGlueExtension.so"
linux.x86_64.release = "res://addons/gdcefglue/linux-x64/GDCefGlueExtension.so"
macos.debug = "res://addons/gdcefglue/macos-arm64/GDCefGlueExtension.dylib"
macos.release = "res://addons/gdcefglue/macos-arm64/GDCefGlueExtension.dylib"

[dependencies]
windows.x86_64 = {
  "res://addons/gdcefglue/windows-x64/libcef.dll": "",
  "res://addons/gdcefglue/windows-x64/resources.pak": "",
  "res://addons/gdcefglue/windows-x64/chrome_100_percent.pak": "",
  "res://addons/gdcefglue/windows-x64/chrome_200_percent.pak": "",
  "res://addons/gdcefglue/windows-x64/icudtl.dat": "",
  "res://addons/gdcefglue/windows-x64/v8_context_snapshot.bin": "",
  "res://addons/gdcefglue/windows-x64/vk_swiftshader.dll": "",
  "res://addons/gdcefglue/windows-x64/vk_swiftshader_icd.json": "",
  "res://addons/gdcefglue/windows-x64/vulkan-1.dll": "",
  "res://addons/gdcefglue/windows-x64/chrome_elf.dll": "",
  "res://addons/gdcefglue/windows-x64/d3dcompiler_47.dll": "",
  "res://addons/gdcefglue/windows-x64/libEGL.dll": "",
  "res://addons/gdcefglue/windows-x64/libGLESv2.dll": ""
}
linux.x86_64 = {
  "res://addons/gdcefglue/linux-x64/libcef.so": "",
  "res://addons/gdcefglue/linux-x64/resources.pak": "",
  "res://addons/gdcefglue/linux-x64/chrome_100_percent.pak": "",
  "res://addons/gdcefglue/linux-x64/chrome_200_percent.pak": "",
