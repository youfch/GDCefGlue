  "res://addons/gdcefglue/linux-x64/v8_context_snapshot.bin": "",
  "res://addons/gdcefglue/linux-x64/libEGL.so": "",
  "res://addons/gdcefglue/linux-x64/libGLESv2.so": "",
  "res://addons/gdcefglue/linux-x64/libvk_swiftshader.so": "",
  "res://addons/gdcefglue/linux-x64/libvulkan.so.1": "",
  "res://addons/gdcefglue/linux-x64/vk_swiftshader_icd.json": ""
}