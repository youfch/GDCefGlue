<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DotnetVersion>net8.0</DotnetVersion>
<!--      Recommended version number 134.6998.178-->
    <CefGlueCommonVersion>134.6998.178</CefGlueCommonVersion>
    <CefRuntimeVersion>145.0.26</CefRuntimeVersion>
    
    <!-- Auto-detect platform -->
    <CefGlueTargetPlatform Condition=" '$(CefGlueTargetPlatform)' == '' And '$(OS)' == 'Windows_NT' ">win-x64</CefGlueTargetPlatform>
    <CefGlueTargetPlatform Condition=" '$(CefGlueTargetPlatform)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true' ">linux-x64</CefGlueTargetPlatform>
    <CefGlueTargetPlatform Condition=" '$(CefGlueTargetPlatform)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true' ">osx-x64</CefGlueTargetPlatform>
    <CefGlueTargetPlatform Condition=" '$(CefGlueTargetPlatform)' == '' ">win-x64</CefGlueTargetPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefGlue.Common" Version="$(CefGlueCommonVersion)" />
    <!-- Windows CEF -->
    <PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="$(CefRuntimeVersion)" Condition=" '$(CefGlueTargetPlatform)' == 'win-x64' " />
    <!-- Linux CEF - requires cef.redist.linux package -->
    <!-- <PackageReference Include="chromiumembeddedframework.runtime.linux-x64" Version="$(CefRuntimeVersion)" Condition=" '$(CefGlueTargetPlatform)' == 'linux-x64' " /> -->
    <!-- macOS CEF - requires cef.redist.osx package -->
    <!-- <PackageReference Include="chromiumembeddedframework.runtime.osx-x64" Version="$(CefRuntimeVersion)" Condition=" '$(CefGlueTargetPlatform)' == 'osx-x64' " /> -->
  </ItemGroup>

  <Target Name="CopyCefFilesToOutput" AfterTargets="Build">
    <PropertyGroup>
      <NuGetPackagesPath>$(NuGetPackageRoot)</NuGetPackagesPath>
      <CefPackagePath>$(NuGetPackagesPath)chromiumembeddedframework.runtime.$(CefGlueTargetPlatform)\$(CefRuntimeVersion)\runtimes\$(CefGlueTargetPlatform)\native\</CefPackagePath>
      <CefLocalesPath>$(NuGetPackagesPath)chromiumembeddedframework.runtime.$(CefGlueTargetPlatform)\$(CefRuntimeVersion)\CEF\$(CefGlueTargetPlatform)\locales\</CefLocalesPath>
      <BrowserProcessPath>$(NuGetPackagesPath)cefglue.common\$(CefGlueCommonVersion)\bin\$(CefGlueTargetPlatform)\</BrowserProcessPath>
      <CefOutputPath>$(TargetDir)runtimes\$(CefGlueTargetPlatform)\native\</CefOutputPath>
      <CefLocalesOutputPath>$(TargetDir)runtimes\$(CefGlueTargetPlatform)\native\locales\</CefLocalesOutputPath>
      <BrowserProcessSubDir>$(TargetDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(TargetDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Build Configuration ===" Importance="high" />
    <Message Text="CefGlueTargetPlatform: $(CefGlueTargetPlatform)" Importance="high" />
    <Message Text="NuGetPackagesPath: $(NuGetPackagesPath)" Importance="high" />
    <Message Text="CefPackagePath: $(CefPackagePath)" Importance="high" />
    <Message Text="BrowserProcessPath: $(BrowserProcessPath)" Importance="high" />
    <Message Text="TargetDir: $(TargetDir)" Importance="high" />
    
    <MakeDir Directories="$(CefOutputPath)" />
    <MakeDir Directories="$(CefLocalesOutputPath)" />
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(CefOutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(CefPackagePath)')" />
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(CefPackagePath)')" />
    
    <ItemGroup>
      <CefLocaleFiles Include="$(CefLocalesPath)*.pak" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(CefLocalesOutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(CefLocalesPath)')" />
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(RootLocalesPath)" SkipUnchangedFiles="true" Condition="Exists('$(CefLocalesPath)')" />
    
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" Condition="Exists('$(BrowserProcessPath)')" />
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(BrowserProcessPath)')" />
    
    <Message Text="=== CEF Copy Complete ===" Importance="high" />
  </Target>

  <Target Name="CopyCefFilesForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <NuGetPackagesPath>$(NuGetPackageRoot)</NuGetPackagesPath>
      <CefPackagePath>$(NuGetPackagesPath)chromiumembeddedframework.runtime.$(CefGlueTargetPlatform)\$(CefRuntimeVersion)\runtimes\$(CefGlueTargetPlatform)\native\</CefPackagePath>
      <CefLocalesPath>$(NuGetPackagesPath)chromiumembeddedframework.runtime.$(CefGlueTargetPlatform)\$(CefRuntimeVersion)\CEF\$(CefGlueTargetPlatform)\locales\</CefLocalesPath>
      <BrowserProcessPath>$(NuGetPackagesPath)cefglue.common\$(CefGlueCommonVersion)\bin\$(CefGlueTargetPlatform)\</BrowserProcessPath>
      <CefOutputPath>$(PublishDir)runtimes\$(CefGlueTargetPlatform)\native\</CefOutputPath>
      <CefLocalesOutputPath>$(PublishDir)runtimes\$(CefGlueTargetPlatform)\native\locales\</CefLocalesOutputPath>
      <BrowserProcessSubDir>$(PublishDir)CefGlueBrowserProcess\</BrowserProcessSubDir>
      <RootLocalesPath>$(PublishDir)locales\</RootLocalesPath>
    </PropertyGroup>
    
    <Message Text="=== CEF Publish Configuration ===" Importance="high" />
    <Message Text="CefGlueTargetPlatform: $(CefGlueTargetPlatform)" Importance="high" />
    <Message Text="NuGetPackagesPath: $(NuGetPackagesPath)" Importance="high" />
    <Message Text="PublishDir: $(PublishDir)" Importance="high" />
    
    <MakeDir Directories="$(CefOutputPath)" />
    <MakeDir Directories="$(CefLocalesOutputPath)" />
    <MakeDir Directories="$(BrowserProcessSubDir)" />
    <MakeDir Directories="$(RootLocalesPath)" />
    
    <ItemGroup>
      <CefNativeFiles Include="$(CefPackagePath)*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(CefOutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(CefPackagePath)')" />
    <Copy SourceFiles="@(CefNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(CefPackagePath)')" />
    
    <ItemGroup>
      <CefLocaleFiles Include="$(CefLocalesPath)*.pak" />
    </ItemGroup>
    
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(CefLocalesOutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(CefLocalesPath)')" />
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(RootLocalesPath)" SkipUnchangedFiles="true" Condition="Exists('$(CefLocalesPath)')" />
    
    <ItemGroup>
      <BrowserProcessFiles Include="$(BrowserProcessPath)**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(BrowserProcessSubDir)" SkipUnchangedFiles="true" Condition="Exists('$(BrowserProcessPath)')" />
    <Copy SourceFiles="@(BrowserProcessFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(BrowserProcessPath)')" />
    
    <Message Text="=== CEF Publish Complete ===" Importance="high" />
  </Target>
</Project>
